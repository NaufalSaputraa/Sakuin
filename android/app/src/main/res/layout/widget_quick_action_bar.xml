<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Left side: Balance & Sisa Budget -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="SAKUIN"
            android:textColor="#A29BFE"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_total_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="Rp 0"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_remaining_budget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Sisa: Rp 0"
            android:textColor="#A0A0B2"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Right side: Quick Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Voice Button (Mic) -->
        <ImageButton
            android:id="@+id/btn_voice"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_circle"
            android:contentDescription="Voice Input"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mic" />

        <!-- Scan Button (Camera) -->
        <ImageButton
            android:id="@+id/btn_scan"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_circle"
            android:contentDescription="Scan Struk"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_camera" />

        <!-- Quick Entry Button (+) -->
        <ImageButton
            android:id="@+id/btn_quick_entry"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_primary_circle"
            android:contentDescription="Catat Cepat"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

</LinearLayout>
